<!DOCTYPE html>
<html>
  <head>
    <title>Student Application Form</title>
    </head>
    <body>
      <h2>Student Application Form</h2>
      <center>
      <form action="#"method="Post">
        
        <label for="name">Full name:</label><br></label><br>
        <input type="text"id="name"name="name"requried><br><br>
        <label for="DOD">date of birth:</label><br><br>
        <input type="date"id="DOD"name="DOD"requried><br><br>
         <label>gender:</label><br>
         <input type="ratio"id="male"name="gender"value="male">
         <label for="male">male</label>
         <input type="ratio"id="Female"name="gender"value="Female">
         <label for="Female">Female</label><br>
         <input type="ratio"id="other"name="gender"values="other">
         <label for="other">other</label><br><br>
         <label for="email">email:</label><br>
         <input type="email"id="email"name="email"request<br><br>
         <label for="phone">phone Number:</label><br><br>
        <input type="tel"id="phone"name="phone"requried><br><br>
        <label for="course">select course:</label><br>
        <select id="Course"name="course">
        <option value="BCA">BCA</option>
        <option value="BBA">BBA</option>
        <option value="Bcom">Bcom</option>
        <option value="Bsc">Bsc</option>
        <option value="BA">BA</option>
        </select><br><br>
        <label>Language Know:</label><br>
        <input type="Checkbox"name="Language"vale="English">
        <input type="Checkbox"name="Language"vale="Hindi">
        <input type="Checkbox"name="Language"vale="Kannada">
        <input type="Checkbox"name="Language"vale="other">
        <br><br>
        <label for="Address">Adress:</label><br>
        <textarea id="adress name="address rows="4"cols="40"></textarea><br><br>
        <input type="submit"value="submit"><br><br>
        <input type="reset"value="reset"><br><br>
         </form>
         </body>
         </html>

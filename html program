<!DOCTYPE html>
<html>
<head>
    <title>My Profile Card</title>
    <style>
        body{
            background: linear-gradient(to right,#ff9a9e,#fad0c4);
            font-family: Arial, sans-serif;
            display:flex;
            justify-content:center;
            align-items:center;
            height:100vh;
        }

        .card{
            background:white;
            width:300px;
            text-align:center;
            border-radius:20px;
            padding:20px;
            box-shadow:0 10px 20px rgba(0,0,0,0.2);
        }

        .avatar{
            width:100px;
            height:100px;
            border-radius:50%;
            background:#6c63ff;
            color:white;
            font-size:40px;
            line-height:100px;
            margin:auto;
        }

        button{
            background:#6c63ff;
            color:white;
            border:none;
            padding:10px 20px;
            border-radius:25px;
            cursor:pointer;
        }

        button:hover{
            background:#4b45c7;
        }
    </style>
</head>
<body>

<div class="card">
    <div class="avatar">N</div>
    <h2>Neha</h2>
    <p>BCA Student</p>
    <p>Dreaming big, coding bigger. 💻✨</p>

    <button onclick="alert('Keep Coding, Neha! 🚀')">
        Click Me
    </button>
</div>

</body>
</html>
